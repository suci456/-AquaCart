# ==============================================================================
# AquaCart Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file with production secrets to version control.
# ==============================================================================

# Application Environment Mode (development / staging / production)
APP_ENV=development
USE_MOCK_DATA=true # Set to false when live Firebase credentials are configured

# ------------------------------------------------------------------------------
# Firebase Project Credentials (from Firebase Console -> Project Settings)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=AIzaSyDummyApiKeyForAquaCartDemo12345
FIREBASE_AUTH_DOMAIN=aquacart-califnco.firebaseapp.com
FIREBASE_PROJECT_ID=aquacart-califnco
FIREBASE_STORAGE_BUCKET=aquacart-califnco.appspot.com
FIREBASE_MESSAGING_SENDER_ID=109283746501
FIREBASE_APP_ID=1:109283746501:android:89abc7482def1024

# ------------------------------------------------------------------------------
# Razorpay Test Mode Credentials (from Razorpay Dashboard -> Settings -> API Keys)
# ------------------------------------------------------------------------------
# Test mode key ID prefix is always 'rzp_test_'
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayTestSecretKeyHere
RAZORPAY_MERCHANT_NAME=AquaCart Water Solutions
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# n8n AI Instagram Automation Credentials
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-YourOpenAIApiKeyHere
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000
META_PAGE_ACCESS_TOKEN=EAAG...YourLongLivedPageAccessToken
N8N_WEBHOOK_URL=http://localhost:5678/webhook/instagram-daily-post
